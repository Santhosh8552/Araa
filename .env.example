# ====================================================================
# TRADE.PRO AI BOT & GEMINI ENGINE ENVIRONMENT CONFIGURATION
# ====================================================================

# Google Gemini API Key
# Obtain an official key from Google AI Studio: https://aistudio.google.com/app/apikey
# Do not commit real keys to source control.
GEMINI_API_KEY=your_gemini_api_key_here

# Verified Production Models:
# - gemini-2.5-flash (Recommended default: low latency, high throughput)
# - gemini-2.0-flash (Resilient fallback)
GEMINI_MODEL=gemini-2.5-flash

# Operational Port Settings (Local Mac / Server)
# User Dashboard Port: 7777
# Admin Panel Port: 7779
# Flask REST API Port: 5050
PORT=5050
USER_PORT=7777
ADMIN_PORT=7779

# Trading Environment Mode:
# - PAPER (Default: real-time live quotes with zero financial risk)
# - LIVE  (Requires authorized broker credentials configured below)
TRADING_MODE=PAPER

# Broker Integration Credentials (Required only for LIVE mode)
BROKER_NAME=BINANCE
BROKER_API_KEY=your_broker_api_key_here
BROKER_API_SECRET=your_broker_api_secret_here

# Risk Management Defaults
DEFAULT_RISK_PCT=2.0
MAX_POSITIONS=10
DEFAULT_STRATEGY=SCALP

# --------------------------------------------------------------------
# Admin panel login (REQUIRED to use /admin - there is no default password)
# --------------------------------------------------------------------
ADMIN_USERNAME=choose_an_admin_username
ADMIN_PASSWORD=choose_a_long_random_password
# Admin session lifetime in seconds (default 12h)
ADMIN_SESSION_TTL=43200

# --------------------------------------------------------------------
# Encrypt stored broker API keys/secrets (Zerodha / CoinDCX) in the database.
# Use a long random string and KEEP IT SAFE: losing it makes stored keys unreadable.
SECRETS_KEY=generate_a_long_random_string

# Company Proprietary Desk Strict Security Flags (Production = 1)
AUTH_STRICT=1
REQUIRE_ENCRYPTION=1
COMPANY_ONLY_MODE=1
COMPANY_WORKER_ENABLED=1
COMPANY_WORKER_INTERVAL_SEC=300
SEED_DEMO_USERS=0

# PostgreSQL & Redis Production Infrastructure
DATABASE_URL=postgresql://araa_admin:change_me_before_prod@postgres:5432/araa_trading
REDIS_URL=redis://redis:6379/0
STATIC_EGRESS_IP=your_whitelisted_static_server_ip

# CoinDCX futures: leverage used only if legacy contract check does not specify max
COINDCX_FALLBACK_MAX_LEVERAGE=100
